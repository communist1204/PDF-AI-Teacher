diff --git a/src/backend.h b/src/backend.h
--- a/src/backend.h
+++ b/src/backend.h
@@ -23,12 +23,12 @@ struct BackendPair {
     bool           has_gpu;
 };
 
-// Physical core count heuristic (logical / 2 for HT/SMT).
-// Used for GGML CPU thread count: GEMM shares SIMD units across hyperthreads,
-// so one thread per physical core is optimal.
+// PDF-AI-Teacher: bound CPU work inside this child process. This does not
+// change the machine environment or inspect other jobs. Unknown values
+// remain at two threads; the app may explicitly request four.
 static int backend_cpu_n_threads(void) {
-    int n = (int) std::thread::hardware_concurrency() / 2;
-    return n > 0 ? n : 1;
+    const char * value = std::getenv("PDF_AI_TTS_THREADS");
+    return value && std::strcmp(value, "4") == 0 ? 4 : 2;
 }
 
 // Standalone CPU backend via Registry API (DL-safe, no ggml-cpu.h needed).
