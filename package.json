{
  "name": "pdf-ai-teacher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "start": "tsx apps/server/src/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/create-fixtures.mjs",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/run-desktop.mjs",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "desktop:runtime": "node node_modules/electron/install.js",
    "test:desktop:restart": "node scripts/verify-desktop-restart.mjs",
    "test:desktop:network": "node scripts/verify-desktop-network.mjs",
    "test:desktop:login": "node scripts/verify-desktop-login.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jose": "6.2.12",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "openai": "^7.23.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
