{
  "name": "screen-reader",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run desktop:build && node scripts/run-desktop.mjs",
    "dev": "vite --host 127.0.0.1 --port 4320 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/run-desktop.mjs",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4320 --strictPort"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
