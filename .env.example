# Copy to .env on this computer. Never paste real keys into chats or commit .env.
# No private .env => explicit demo mode, no provider requests.
DEMO_MODE=true
APP_HOST=127.0.0.1
APP_PORT=4317

# Set DEMO_MODE=false only when you intend to send selected data to a paid API.
# Model names must be available to your own account; no model is assumed verified.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=
VISION_MODEL=
# Text/image understanding uses the selected Responses model; TTS never solves the question.
# Quality-first example checked in official docs 2026-09-29, NOT tested with your account:
# CHAT_MODEL=gpt-6-astra
# VISION_MODEL=gpt-6-astra
# CHAT_REASONING_EFFORT=xhigh
# VISION_REASONING_EFFORT=xhigh
# TEACHING_MAX_OUTPUT_TOKENS=32000
# TEACHING_TIMEOUT_MS=300000
# https://developers.openai.com/api/docs/models/gpt-6-astra
# https://developers.openai.com/api/docs/guides/reasoning
# Astra supports low / medium / high / xhigh / max. Higher effort may be slower/costlier.
# Blank effort omits reasoning entirely for compatibility. Other models support different levels.
# No model fallback or automatic retry; account/model permission errors are shown directly.
CHAT_REASONING_EFFORT=
VISION_REASONING_EFFORT=
# Output limit includes hidden reasoning tokens; default 16000, allowed 1024..128000.
# Truncated answers fail visibly. A larger budget may increase costs; no answer is guaranteed correct.
TEACHING_MAX_OUTPUT_TOKENS=
# Only teaching requests use this timeout: default 180000 ms, allowed 1000..600000.
# TTS/transcription/realtime keep the separate REQUEST_TIMEOUT_MS below.
TEACHING_TIMEOUT_MS=

TTS_MODEL=
TTS_VOICE=marin
# Natural delivery (official docs, not verified with your account):
# Example TTS_MODEL=gpt-4o-mini-tts; TTS_VOICE=marin (or cedar).
# Voices are optimized for English; Chinese listening quality still needs testing.
# https://developers.openai.com/api/docs/guides/text-to-speech
# Supported models default to a warm, natural Chinese teaching voice with pauses.
# Optional style override; input remains the exact text to read, with no added words.
TTS_INSTRUCTIONS=
# Blank: auto-enable only for documented GPT-4o mini TTS models at the official URL.
# Other models / compatible services: set true ONLY after confirming support.
# false disables instructions. tts-1 / tts-1-hd never accept instructions.
TTS_SUPPORTS_INSTRUCTIONS=

# Optional microphone features; leave blank for typing + natural TTS only.
# M2 push-to-talk transcription. Separate from CHAT_MODEL / TTS_MODEL.
# Official documented example: gpt-transcribe (verify your own account access).
# https://developers.openai.com/api/docs/guides/speech-to-text
# Finishing a recording in API mode uploads it for transcription and may incur costs.
# Demo mode records only locally, never uploads or invents a transcript.
TRANSCRIPTION_MODEL=
# M3 Realtime WebRTC: only the official OPENAI_BASE_URL is supported.
# Starting the app makes no paid request. Explicitly connecting uploads microphone audio.
# Example REALTIME_MODEL=gpt-realtime-2.1 (verify your account access).
# https://developers.openai.com/api/docs/guides/voice-webrtc
REALTIME_MODEL=
REALTIME_VOICE=marin
# Separate input transcription, required to confirm speech before a response.
# Example: gpt-4o-mini-transcribe. gpt-transcribe is NOT used for this WebRTC adapter.
# Supported: gpt-4o-mini-transcribe, gpt-4o-mini-transcribe-2025-12-15, gpt-4o-transcribe, whisper-1.
REALTIME_TRANSCRIPTION_MODEL=

# This application's limits do not replace provider billing limits.
MAX_SESSION_REQUESTS=100
REQUESTS_PER_MINUTE=30
REQUEST_TIMEOUT_MS=45000
# In-memory LRU audio cache, shared hard cap; contents disappear on restart.
TTS_CACHE_MB=32
