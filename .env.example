# Copy to .env on this computer. Never paste real keys into chats or commit .env.
# No private .env => explicit demo mode, no provider requests.
DEMO_MODE=true
APP_HOST=127.0.0.1
APP_PORT=4317

# Set DEMO_MODE=false only when you intend to send selected data to a paid API.
# Model names must be available to your own account; no model is assumed verified.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=
VISION_MODEL=
TTS_MODEL=
TTS_VOICE=coral
# Natural delivery (official docs, not verified with your account):
# Example TTS_MODEL=gpt-4o-mini-tts; TTS_VOICE=marin (or cedar).
# Voices are optimized for English; Chinese listening quality still needs testing.
# https://developers.openai.com/api/docs/guides/text-to-speech
# Supported models default to a warm, natural Chinese teaching voice with pauses.
# Optional style override; input remains the exact text to read, with no added words.
TTS_INSTRUCTIONS=
# Blank: auto-enable only for documented GPT-4o mini TTS models at the official URL.
# Other models / compatible services: set true ONLY after confirming support.
# false disables instructions. tts-1 / tts-1-hd never accept instructions.
TTS_SUPPORTS_INSTRUCTIONS=

# M2 push-to-talk transcription. Separate from CHAT_MODEL / TTS_MODEL.
# Official documented example: gpt-transcribe (verify your own account access).
# https://developers.openai.com/api/docs/guides/speech-to-text
# Finishing a recording in API mode uploads it for transcription and may incur costs.
# Demo mode records only locally, never uploads or invents a transcript.
TRANSCRIPTION_MODEL=
# M3 realtime is reserved, not consumed or tested in this release.
REALTIME_MODEL=

# This application's limits do not replace provider billing limits.
MAX_SESSION_REQUESTS=100
REQUESTS_PER_MINUTE=30
REQUEST_TIMEOUT_MS=45000
# In-memory LRU audio cache, shared hard cap; contents disappear on restart.
TTS_CACHE_MB=32
